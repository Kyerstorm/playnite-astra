<UserControl x:Class="Astra.Views.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Astra.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme swatch-card: a clickable Border, highlighted when IsSelected. Each item's
                 DataContext is already the ThemeOption itself (no RelativeSource indirection
                 needed here, unlike AstraShellView's nav rows which bind Tag from an ancestor
                 view-model). -->
            <Style x:Key="ThemeSwatchCard" TargetType="Border">
                <Setter Property="Width" Value="110" />
                <Setter Property="Height" Value="64" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Accent swatch dot: a clickable Ellipse, ring-highlighted when IsSelected. -->
            <Style x:Key="AccentSwatchRing" TargetType="Border">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,14" />

            <Border Style="{StaticResource StatCard}">
                <StackPanel Margin="6">
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                    <TextBlock Text="Applies only to Astra's own pages, independent of your Playnite theme."
                               FontSize="11" Opacity="0.55" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding ThemeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ThemeSwatchCard}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <TextBlock Text="{Binding Label}" FontSize="12" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ACCENT COLOR" Style="{StaticResource SectionLabel}" Margin="0,16,0,10" />
                    <TextBlock Text="Only visible when a theme other than &quot;Follow Playnite&quot; is selected."
                               FontSize="11" Opacity="0.55" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding AccentOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AccentSwatchRing}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Ellipse Width="26" Height="26" Fill="{Binding Hex, Converter={StaticResource ColorHexToBrushConverter}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Reset to default" Command="{Binding ResetToDefaultCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Padding="10,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
