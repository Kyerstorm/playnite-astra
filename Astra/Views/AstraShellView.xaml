<UserControl x:Class="Astra.Views.AstraShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Astra.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <!-- Maps each page view-model to its view, so ContentControl.Content just needs
             to be set to the view-model (see AstraShellViewModel.CurrentPage). -->
        <DataTemplate DataType="{x:Type local:HomeViewModel}">
            <local:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:TrendsViewModel}">
            <local:TrendsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:MostPlayedViewModel}">
            <local:MostPlayedView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:RecapViewModel}">
            <local:RecapView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:BacklogViewModel}">
            <local:BacklogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThemeSettingsViewModel}">
            <local:ThemeSettingsView />
        </DataTemplate>

        <!-- Nav row: Tag carries this row's own "am I the active page" bool so one shared
             style/trigger set can highlight whichever row is active, hover, or neither.
             Hover/active use a fixed neutral translucent gray rather than a DynamicResource
             brush key - only TextBrush/NormalBorderBrush/GlyphBrush/PopupBackgroundBrush are
             confirmed against Playnite's shipped theme (see CLAUDE.md), and a gray overlay at
             low alpha reads fine as a subtle highlight under both light and dark themes. -->
        <Style x:Key="NavRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14808080" />
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#22808080" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Left accent bar shown only on the active row, echoing the mockup's inset-accent
             pattern for the currently-selected nav item. -->
        <Style x:Key="ActiveAccentBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Fill" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=Tag}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Astra's own internal nav panel, distinct from Playnite's outer sidebar rail
             (Astra registers a single icon there - see Astra.cs). -->
        <Border Grid.Column="0" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,18">
                <TextBlock Text="ASTRA" FontSize="11" FontWeight="SemiBold" Opacity="0.5" Margin="18,0,0,10" />

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsHomeActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowHomeCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Polygon Points="8,1 1,7.5 15,7.5" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="10" Height="8" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <TextBlock Text="Home" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsTrendsActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowTrendsCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Polyline Points="1,13 6,7 9,10 15,2" Stroke="{DynamicResource GlyphBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                            <TextBlock Text="Trends" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsMostPlayedActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowMostPlayedCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <TextBlock Text="Most Played" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsRecapActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowRecapCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Rectangle Width="3" Height="7" Margin="0,0,2,0" Fill="{DynamicResource GlyphBrush}" VerticalAlignment="Bottom" />
                                    <Rectangle Width="3" Height="12" Margin="0,0,2,0" Fill="{DynamicResource GlyphBrush}" VerticalAlignment="Bottom" />
                                    <Rectangle Width="3" Height="16" Fill="{DynamicResource GlyphBrush}" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Recap" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsBacklogActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowBacklogCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <!-- Stack-of-games "pile" glyph: three overlapping rounded rectangles,
                                     distinct from the other four icons' shapes. -->
                                <Rectangle Width="14" Height="4" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="0,0,0,0" Fill="{DynamicResource GlyphBrush}" Opacity="0.45" />
                                <Rectangle Width="14" Height="4" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="0,0,0,5" Fill="{DynamicResource GlyphBrush}" Opacity="0.7" />
                                <Rectangle Width="14" Height="4" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" Margin="0,0,0,10" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <TextBlock Text="Backlog" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource NavRow}" Tag="{Binding IsThemeSettingsActive}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowThemeSettingsCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Rectangle Style="{StaticResource ActiveAccentBar}" />
                        <StackPanel Orientation="Horizontal" Margin="16,9">
                            <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <!-- Minimalist "settings sliders" glyph: three horizontal tracks
                                     with an offset knob on each - distinct in silhouette from the
                                     other five nav icons. -->
                                <Rectangle Width="14" Height="2" VerticalAlignment="Top" Fill="{DynamicResource GlyphBrush}" Opacity="0.5" />
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,-1.5,0,0" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="14" Height="2" VerticalAlignment="Center" Fill="{DynamicResource GlyphBrush}" Opacity="0.5" />
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" Fill="{DynamicResource GlyphBrush}" />
                                <Rectangle Width="14" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource GlyphBrush}" Opacity="0.5" />
                                <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,-1.5" Fill="{DynamicResource GlyphBrush}" />
                            </Grid>
                            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</UserControl>
