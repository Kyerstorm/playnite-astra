<UserControl x:Class="Astra.Views.TrendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Astra.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <local:SignedHoursDeltaConverter x:Key="SignedHoursDeltaConverter" />
            <local:SecondsToHoursMinutesConverter x:Key="SecondsToHoursMinutesConverter" />
            <local:MonthNumberToNameConverter x:Key="MonthNumberToNameConverter" />
            <local:NullableEnumToStringConverter x:Key="NullableEnumToStringConverter" />
            <local:BarFractionToGridLengthConverter x:Key="BarFractionToGridLengthConverter" />
            <local:IntensityToOpacityConverter x:Key="IntensityToOpacityConverter" />

            <!-- One row of a horizontal bar chart: label, then a two-column track where the left
                 column's star-width is the value's fraction of the busiest row (see
                 BarFractionToGridLengthConverter) - used for both Weekday and Session Length
                 distributions so they read as one visual language. -->
            <Style x:Key="BarTrack" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Opacity" Value="0.75" />
            </Style>

            <!-- Two-column analytics card (Gaming Rhythm, Session Activity, ...) - a StatCard-styled
                 border with a section title and a grid of label/value pairs. Reused for every
                 non-chart analytics section added across the Trends extension phases. -->
            <Style x:Key="AnalyticsCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="Margin" Value="6,6,6,10" />
            </Style>
            <Style x:Key="AnalyticsMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="AnalyticsMetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="AnalyticsMetricSubValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Margin" Value="0,1,0,0" />
            </Style>

            <!-- Compact segmented control for Day/Week/Month/Year - same active/hover treatment as the
                 shell's own left-nav rows (NavRow/ActiveAccentBar in AstraShellView.xaml), reused here
                 rather than a full TabControl per the "don't introduce a large tab system" guidance. -->
            <Style x:Key="GranularityButton" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#14808080" />
                    </Trigger>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                        <Setter Property="Background" Value="#22808080" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="GranularityButtonText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + year nav (Month mode only - see TrendsViewModel.IsYearNavVisible) -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock Text="Playtime Trends" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsYearNavVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="◀" Command="{Binding PreviousYearCommand}" Width="32" Margin="4,0" />
                <TextBlock Text="{Binding Year}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Width="60" TextAlignment="Center" />
                <Button Content="▶" Command="{Binding NextYearCommand}" Width="32" Margin="4,0" />
            </StackPanel>
        </DockPanel>

        <!-- Granularity segmented control + range preset picker -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Style="{StaticResource GranularityButton}" Tag="{Binding IsDaySelected}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectDayCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="DAY" Style="{StaticResource GranularityButtonText}" />
                </Border>
                <Border Style="{StaticResource GranularityButton}" Tag="{Binding IsWeekSelected}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectWeekCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="WEEK" Style="{StaticResource GranularityButtonText}" />
                </Border>
                <Border Style="{StaticResource GranularityButton}" Tag="{Binding IsMonthSelected}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectMonthCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="MONTH" Style="{StaticResource GranularityButtonText}" />
                </Border>
                <Border Style="{StaticResource GranularityButton}" Tag="{Binding IsYearSelected}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectYearCommand}" />
                    </Border.InputBindings>
                    <TextBlock Text="YEAR" Style="{StaticResource GranularityButtonText}" />
                </Border>
            </StackPanel>

            <ComboBox DockPanel.Dock="Right" Width="160" VerticalAlignment="Center"
                      ItemsSource="{Binding AvailableRangeOptions}" SelectedItem="{Binding SelectedRangeOption}" />
        </DockPanel>

        <!-- Everything below the header/controls scrolls as one column - the page is not meant to fit
             in a single viewport (spec section 3), and every analytics section added across the
             Trends extension phases is appended here. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Summary cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Trend.TotalPlaytimeSeconds, Converter={StaticResource SecondsToHoursConverter}, StringFormat='{}{0}h'}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="TOTAL PLAYTIME" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding PreviousPeriodDeltaSeconds, Converter={StaticResource SignedHoursDeltaConverter}}"
                                       FontSize="10" Opacity="0.55" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Trend.AveragePlaytimeSeconds, Converter={StaticResource SecondsToHoursConverter}, StringFormat='{}{0}h'}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="AVERAGE / PERIOD" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValue}">
                                <Run Text="{Binding Trend.ActivePeriods, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Trend.TotalPeriods, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="ACTIVE PERIODS" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Trend.SessionCount}" Style="{StaticResource StatValue}" />
                            <TextBlock Text="SESSIONS" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="PLAYTIME" Style="{StaticResource SectionLabel}" Margin="6,0,0,8" />

                <!-- Wide/shallow area chart - target ~2.5:1 to 4:1, enforced via AspectRatioHeightConverter
                     (ratio = height/width) rather than a fixed pixel height, so it stays proportional
                     across 1080p/1440p/4K instead of stretching arbitrarily tall. -->
                <Border Style="{StaticResource StatCard}" Padding="16" VerticalAlignment="Top"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource AspectRatioHeightConverter}, ConverterParameter=0.32}"
                        MinHeight="160" MaxHeight="420">
                    <local:TrendChartControl Trend="{Binding Trend}" />
                </Border>

                <!-- Gaming Rhythm + Session Activity: two columns on wide layouts, per spec section 30 -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="GAMING RHYTHM" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="BUSIEST DAY" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.BusiestDayOfWeek, Converter={StaticResource NullableEnumToStringConverter}}" Style="{StaticResource AnalyticsMetricValue}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.BusiestDayOfWeekSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricSubValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                    <TextBlock Text="BUSIEST MONTH" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.BusiestMonth, Converter={StaticResource MonthNumberToNameConverter}}" Style="{StaticResource AnalyticsMetricValue}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.BusiestMonthSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricSubValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="LONGEST STREAK" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.LongestStreakDays, StringFormat='{}{0} days'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="CURRENT STREAK" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rhythm.CurrentStreakDays, StringFormat='{}{0} days'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="SESSION ACTIVITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="TOTAL SESSIONS" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Sessions.TotalSessions}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                    <TextBlock Text="AVERAGE SESSION" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Sessions.AverageSessionSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                    <TextBlock Text="LONGEST SESSION" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Sessions.LongestSessionSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                    <TextBlock Text="SHORTEST SESSION" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Sessions.ShortestSessionSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="SESSIONS / ACTIVE DAY" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Sessions.AverageSessionsPerActiveDay, StringFormat='{}{0:0.0}'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Calendar activity heatmap - always one full year (TrendsViewModel.HeatmapTrend),
                     independent of the main chart's Day/Week/Month/Year selection (spec section 10). -->
                <Border Style="{StaticResource AnalyticsCard}">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                        <local:ActivityHeatmapControl Trend="{Binding HeatmapTrend}" Height="120" />
                    </StackPanel>
                </Border>

                <!-- Weekday distribution + Session length distribution -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="PLAYTIME BY DAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Analytics.Weekday.Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" ToolTipService.ToolTip="{Binding PlaytimeSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeek}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}, ConverterParameter=remainder}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource BarTrack}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="SESSION LENGTH" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Analytics.SessionLengths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding SessionCount, Mode=OneWay}" /><Run Text=" sessions (" /><Run Text="{Binding Percentage, StringFormat='{}{0:0.#}', Mode=OneWay}" /><Run Text="%)" />
                                                </TextBlock>
                                            </Grid.ToolTip>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}}" />
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}, ConverterParameter=remainder}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource BarTrack}" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding SessionCount}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hour-of-day + Weekday x Hour heatmap -->
                <Border Style="{StaticResource AnalyticsCard}">
                    <StackPanel>
                        <TextBlock Text="WHEN DO YOU PLAY?" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />

                        <!-- Compact 24-bar strip: one vertical bar per hour, bottom-anchored via a
                             two-row Grid (spacer + bar) reusing BarFractionToGridLengthConverter
                             vertically instead of horizontally. -->
                        <ItemsControl ItemsSource="{Binding Analytics.Hours.Hours}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="24" Height="64" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1,0" ToolTipService.ToolTip="{Binding PlaytimeSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}, ConverterParameter=remainder}" />
                                            <RowDefinition Height="{Binding BarFraction, Converter={StaticResource BarFractionToGridLengthConverter}}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="1" Style="{StaticResource BarTrack}" Height="Auto" VerticalAlignment="Stretch" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="00" FontSize="10" Opacity="0.5" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="03" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="06" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="09" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="12" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="15" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="18" FontSize="10" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="21" FontSize="10" Opacity="0.5" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Weekday x Hour-bucket heatmap: fixed static row/column labels (day names,
                             3-hour bucket starts never change) alongside a data-bound cell grid, so no
                             index math is needed in XAML for the labels themselves. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="00" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="03" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="06" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="09" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="12" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="15" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="18" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="21" FontSize="9" Opacity="0.5" HorizontalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Mon" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Tue" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Wed" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Thu" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Fri" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Sat" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="Sun" FontSize="9" Opacity="0.5" Height="20" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Analytics.WeekdayHours.Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="7" Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1.5" Height="18" CornerRadius="2">
                                            <Border.ToolTip>
                                                <TextBlock>
                                                    <Run Text="{Binding DayOfWeek, Mode=OneWay}" /><Run Text=" " />
                                                    <Run Text="{Binding BucketStartHour, StringFormat='{}{0:00}:00', Mode=OneWay}" /><Run Text="-" /><Run Text="{Binding BucketEndHour, StringFormat='{}{0:00}:00', Mode=OneWay}" />
                                                </TextBlock>
                                            </Border.ToolTip>
                                            <Border.Style>
                                                <!-- Background/Opacity live as base Setters (not local attributes) so the
                                                     DataTrigger below can actually override them - a local property value
                                                     always wins over a Style trigger in WPF, which would otherwise make
                                                     the "no activity" case unreachable. -->
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource GlyphBrush}" />
                                                    <Setter Property="Opacity" Value="{Binding Intensity, Converter={StaticResource IntensityToOpacityConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActivity}" Value="False">
                                                            <Setter Property="Background" Value="#14808080" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Streaks -->
                <Border Style="{StaticResource AnalyticsCard}">
                    <StackPanel>
                        <TextBlock Text="STREAKS" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LONGEST STREAK" Style="{StaticResource AnalyticsMetricLabel}" />
                                <TextBlock Text="{Binding Analytics.Streaks.LongestStreakDays, StringFormat='{}{0} days'}" Style="{StaticResource AnalyticsMetricValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CURRENT STREAK" Style="{StaticResource AnalyticsMetricLabel}" />
                                <TextBlock Text="{Binding Analytics.Streaks.CurrentStreakDays, StringFormat='{}{0} days'}" Style="{StaticResource AnalyticsMetricValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MOST ACTIVE WEEK" Style="{StaticResource AnalyticsMetricLabel}" />
                                <TextBlock Text="{Binding Analytics.Streaks.MostActiveWeekStart, StringFormat='{}{0:d MMM yyyy}'}" Style="{StaticResource AnalyticsMetricValue}" />
                                <TextBlock Text="{Binding Analytics.Streaks.MostActiveWeekSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" Style="{StaticResource AnalyticsMetricSubValue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Playtime Concentration + Game Rotation - the only sections that touch game-level
                     data, and only ever as aggregate counts/shares. Never game names, covers, or a
                     ranking - Most Played owns "which games?" (spec sections 17, 18, 29). -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="PLAYTIME CONCENTRATION" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOP 1" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Concentration.Top1SharePercent, StringFormat='{}{0:0.#}%'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="TOP 3" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Concentration.Top3SharePercent, StringFormat='{}{0:0.#}%'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TOP 5" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Concentration.Top5SharePercent, StringFormat='{}{0:0.#}%'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="TOP 10" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Concentration.Top10SharePercent, StringFormat='{}{0:0.#}%'}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,14,0,0" FontSize="11" Opacity="0.6">
                                <Run Text="{Binding Analytics.Concentration.TotalGamesTouched, Mode=OneWay}" /><Run Text=" games touched" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AnalyticsCard}">
                        <StackPanel>
                            <TextBlock Text="GAME ROTATION" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOUCHED" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rotation.GamesTouched}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="NEW" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rotation.NewGames}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RETURNING" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rotation.ReturningGames}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="MULTI-GAME DAYS" Style="{StaticResource AnalyticsMetricLabel}" />
                                    <TextBlock Text="{Binding Analytics.Rotation.DaysWithMultipleGames}" Style="{StaticResource AnalyticsMetricValue}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Year-over-Year comparison - purely numerical, no red/green or better/worse framing
                     (spec section 16). Only shown for Month/Year granularity, where a specific year is
                     meaningfully in view. -->
                <Border Style="{StaticResource AnalyticsCard}"
                        Visibility="{Binding IsYearComparisonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="0,0,0,12">
                            <Run Text="{Binding YearComparison.Current.Year, Mode=OneWay}" /><Run Text=" VS " /><Run Text="{Binding YearComparison.Previous.Year, Mode=OneWay}" />
                        </TextBlock>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding YearComparison.Previous.Year}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding YearComparison.Current.Year}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Playtime" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding YearComparison.Previous.PlaytimeSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding YearComparison.Current.PlaytimeSeconds, Converter={StaticResource SecondsToHoursMinutesConverter}}" HorizontalAlignment="Center" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sessions" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding YearComparison.Previous.SessionCount}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding YearComparison.Current.SessionCount}" HorizontalAlignment="Center" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Active days" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding YearComparison.Previous.ActiveDays}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding YearComparison.Current.ActiveDays}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Games touched" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding YearComparison.Previous.GamesTouched}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding YearComparison.Current.GamesTouched}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Grouped monthly bars: previous year (dim) + current year (accent), both
                             normalized to the same per-month scale (YearComparisonMonthPoint.*Fraction). -->
                        <ItemsControl ItemsSource="{Binding YearComparison.Months}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="12" Height="90" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="70" Margin="2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="0,0,1,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding PreviousFraction, Converter={StaticResource BarFractionToGridLengthConverter}, ConverterParameter=remainder}" />
                                                    <RowDefinition Height="{Binding PreviousFraction, Converter={StaticResource BarFractionToGridLengthConverter}}" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="1" Background="{DynamicResource NormalBorderBrush}" CornerRadius="2" />
                                            </Grid>
                                            <Grid Grid.Column="1" Margin="1,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding CurrentFraction, Converter={StaticResource BarFractionToGridLengthConverter}, ConverterParameter=remainder}" />
                                                    <RowDefinition Height="{Binding CurrentFraction, Converter={StaticResource BarFractionToGridLengthConverter}}" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="1" Style="{StaticResource BarTrack}" Height="Auto" VerticalAlignment="Stretch" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{Binding Month, Converter={StaticResource MonthNumberToNameConverter}, ConverterParameter=short}"
                                                   FontSize="9" Opacity="0.5" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Your Gaming Year - deterministic sentences translating already-computed statistics
                     into plain language. No AI, no subjective/motivational language (spec section 19). -->
                <Border Style="{StaticResource AnalyticsCard}" Margin="6,6,6,20">
                    <StackPanel>
                        <TextBlock Text="YOUR GAMING YEAR" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding GamingYearSummary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="13" Margin="0,3" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
