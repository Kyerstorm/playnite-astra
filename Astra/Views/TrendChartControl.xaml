<UserControl x:Class="Astra.Views.TrendChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Canvas x:Name="ChartCanvas" ClipToBounds="True" Background="Transparent" MouseLeave="OnCanvasMouseLeave" />

        <!-- Theme-aware tooltip: uses the same PopupBackgroundBrush/NormalBorderBrush pair as every
             other Astra card, so it reads correctly under light/dark/community themes. -->
        <Border x:Name="TooltipBorder" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8,5" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TooltipTitle" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TooltipValue" FontSize="11" Opacity="0.75" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No playtime yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.8" />
            <TextBlock Text="Play some games and your trends will appear here." FontSize="11" Opacity="0.55"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
        </StackPanel>
    </Grid>
</UserControl>
