<UserControl x:Class="Astra.Views.ActivityHeatmapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Canvas x:Name="HeatmapCanvas" ClipToBounds="True" Background="Transparent" MouseLeave="OnCanvasMouseLeave" />

        <Border x:Name="TooltipBorder" Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8,6" HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="TooltipTitle" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TooltipPlaytime" FontSize="11" Opacity="0.85" Margin="0,2,0,0" />
                <TextBlock x:Name="TooltipDetail" FontSize="10" Opacity="0.6" Margin="0,1,0,0" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="No playtime yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.8" />
            <TextBlock Text="Play some games and this year's activity will appear here." FontSize="11" Opacity="0.55"
                       HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
        </StackPanel>
    </Grid>
</UserControl>
