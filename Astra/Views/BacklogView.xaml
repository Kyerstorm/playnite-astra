<UserControl x:Class="Astra.Views.BacklogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Astra.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Same cell shape as MostPlayedGridCellTemplate, minus the rank/trend badges (Backlog
                 games have no playtime/rank), with an AddedDateText line instead. -->
            <DataTemplate x:Key="BacklogCardTemplate">
                <StackPanel Width="120" Height="206" Margin="8" Cursor="Hand" Background="Transparent">
                    <StackPanel.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.OpenGameDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}" />
                    </StackPanel.InputBindings>
                    <Grid Width="120" Height="160">
                        <Border Style="{StaticResource CoverPlaceholderBorder}">
                            <TextBlock Text="{Binding PlaceholderInitials}" FontSize="22" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}" Stretch="UniformToFill" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock Text="{Binding AddedDateText}" Margin="0,2,0,0" FontSize="11" Opacity="0.55" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title (left), games-shown count + Clear filters (right) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="Backlog" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} games shown'}"
                           VerticalAlignment="Center" FontSize="12" Opacity="0.55" Margin="0,0,12,0" />
                <Button Content="Random pick" Command="{Binding PickRandomCommand}" Padding="10,4" Margin="0,0,8,0"
                        ToolTip="Jump to a random game from the currently filtered list" />
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="10,4" />
            </StackPanel>
        </DockPanel>

        <!-- Filter chip rows. An empty GenreFilters/PlatformFilters (fresh library, or a library with
             no genre/platform metadata) just renders an empty WrapPanel under the label - harmless,
             so no extra "hide this section" visibility logic was added. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="GENRES" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding GenreFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource FilterChipToggle}" IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="PLATFORMS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding PlatformFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource FilterChipToggle}" IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Cover grid card -->
        <Border Grid.Row="2" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
                    <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource BacklogCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No games match. Your library has no unplayed games, or the selected filters exclude everything."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextWrapping="Wrap"
                           MaxWidth="360" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="Never-played, non-hidden library games, sorted A-Z. Click a game to jump to its details."
                   FontSize="11" Opacity="0.5" Margin="4,10,0,0" />
    </Grid>
</UserControl>
