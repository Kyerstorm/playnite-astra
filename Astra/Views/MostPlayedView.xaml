<UserControl x:Class="Astra.Views.MostPlayedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Astra.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + year navigation (left), row count (right) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Most Played" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="◀" Command="{Binding PreviousYearCommand}" Width="28" Height="28" Margin="0,0,2,0" />
                <TextBlock Text="{Binding Year}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Width="44" TextAlignment="Center" Opacity="0.85" />
                <Button Content="▶" Command="{Binding NextYearCommand}" Width="28" Height="28" Margin="2,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} games shown, ranked by playtime'}"
                       DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Opacity="0.55" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />

        <!-- Ranked list card -->
        <Border Grid.Row="2" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <DockPanel>
                <!-- Column header row -->
                <Grid DockPanel.Dock="Top" Margin="18,10" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="SemiBold" Opacity="0.5" />
                    <TextBlock Grid.Column="1" Text="GAME" FontSize="11" FontWeight="SemiBold" Opacity="0.5" />
                    <TextBlock Grid.Column="2" Text="PLAYTIME" FontSize="11" FontWeight="SemiBold" Opacity="0.5" TextAlignment="Right" />
                </Grid>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Tag carries the MostPlayedViewModel for the Edit/Reset commands below, and
                                     PlacementTarget is explicitly pinned to this row (RowRoot) so both a
                                     right-click anywhere on the row and a left-click on the "..." button open
                                     the exact same menu, resolving Tag/DataContext the same way either time
                                     (see CLAUDE.md - ContextMenu is not in the visual tree of the row it's
                                     attached to, so PlacementTarget is the only reliable route back to it). -->
                                <Grid x:Name="RowRoot" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Grid.ContextMenu>
                                        <ContextMenu x:Name="RowMenu" PlacementTarget="{Binding ElementName=RowRoot}">
                                            <MenuItem Header="Edit playtime..."
                                                      Command="{Binding PlacementTarget.Tag.EditPlaytimeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Reset to tracked value"
                                                      Command="{Binding PlacementTarget.Tag.ResetPlaytimeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="0,0,0,1" Opacity="0.6" />

                                    <Border Grid.Column="0" Style="{StaticResource RankBadge}" Margin="18,10" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource RankBadgeText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,10" VerticalAlignment="Center">
                                        <Grid Width="44" Height="58" Margin="0,0,12,0">
                                            <Border Style="{StaticResource CoverPlaceholderBorder}">
                                                <TextBlock Text="{Binding PlaceholderInitials}" FontSize="13" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SessionCount, StringFormat='{}{0} sessions'}" FontSize="12" Opacity="0.55" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding PlaytimeSeconds, Converter={StaticResource SecondsToHoursConverter}, StringFormat='{}{0}h'}"
                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,10,18,10" Opacity="0.9" />

                                    <!-- Tag (not ContextMenu!) carries a reference to RowRoot: a ContextMenu can only
                                         be owned by one FrameworkElement at a time, so binding this button's own
                                         ContextMenu property to the same instance Grid.ContextMenu already owns
                                         throws InvalidOperationException ("already the logical child of another
                                         element") the moment each row's template is applied - which silently
                                         killed every row's rendering (see CLAUDE.md BUGS.md-style note). Opening
                                         RowRoot's ContextMenu programmatically from the click handler avoids the
                                         dual-ownership problem entirely while still landing on the exact same menu. -->
                                    <Button Grid.Column="3" Content="&#8942;" FontSize="16" Width="28" Height="28"
                                            Background="Transparent" BorderThickness="0"
                                            Tag="{Binding ElementName=RowRoot}"
                                            Click="MoreButton_Click" ToolTip="Edit or reset playtime" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Data tracked locally by Astra. Use a row's &#8942; menu (or right-click) to correct a game's yearly total."
                   FontSize="11" Opacity="0.5" Margin="4,10,0,0" />
    </Grid>
</UserControl>
