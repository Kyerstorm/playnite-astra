<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Astra</RootNamespace>
    <AssemblyName>Astra</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.17.0" />
    <!-- System.Data.SQLite.Core, NOT Microsoft.Data.Sqlite: the latter pulls in a
         netstandard2.0 SQLitePCLRaw dependency chain (System.Memory/Buffers/
         Runtime.CompilerServices.Unsafe/Numerics.Vectors at specific exact versions)
         that collides with the older versions Playnite's own .NET Framework process
         already has loaded, with no binding redirects available to a plugin — this
         caused real load failures inside Playnite (see BUGS.md). System.Data.SQLite
         is a single self-contained ADO.NET provider with no such shim chain. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- Pinned to 10.0.3, NOT a later version: verified (by extracting the actual .nupkg)
         that NuGet package 10.0.1-10.0.3 is the one whose Newtonsoft.Json.dll carries
         assembly version 10.0.0.0 — an exact match for the copy Playnite itself ships
         and already has loaded in its process. A later package version (11.x/12.x/13.x)
         bumps the assembly version and creates a second, conflicting Newtonsoft.Json
         identity with no way for a plugin to add its own binding redirect into Playnite's
         process. (Playnite.SDK.Data.Serialization would sidestep this entirely, but it
         needs Playnite's own runtime init first and throws when called from a unit test
         outside a running Playnite host — so this direct reference is kept.) See BUGS.md. -->
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
