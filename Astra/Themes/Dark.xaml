<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Custom "Astra-only skin" theme, loaded on demand by AstraThemeApplier and merged into
        AstraShellView's own Resources - never Playnite's global theme. Reuses the exact palette
        already shipped once in ShareCardView.xaml (the original UI mockup's dark/teal colors),
        applied here for the first time as a live, switchable in-app theme rather than a one-shot
        PNG export. Redefines exactly the four DynamicResource keys every existing Astra view
        already binds to - no other view's XAML needs to change for this theme to take effect.
    -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#24262B" />
    <SolidColorBrush x:Key="TextBrush" Color="White" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#3A3C42" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#3EC6E0" />
</ResourceDictionary>
