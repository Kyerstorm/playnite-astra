<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        New light palette - no existing mockup/ShareCard reference to reuse (unlike Dark/Oled).
        Flag for a visual sanity check during manual verification rather than treating it as
        pre-validated. GlyphBrush here is the same default accent as Dark/Oled; AstraThemeApplier
        always overlays the user's chosen accent swatch on top regardless.
    -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#D8D8DC" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#3EC6E0" />
</ResourceDictionary>
