<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        True-black variant of Dark.xaml, for AMOLED/contrast-preferring displays. Same accent and
        text color as Dark - only the panel/border darken further toward pure black.
    -->
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextBrush" Color="White" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#3EC6E0" />
</ResourceDictionary>
